# Корень архива на внешнем диске. Без sentinel-файла .baka-archive.json
# по этому пути любая операция записи блокируется.
BAKA_ARCHIVE_ROOT=/Volumes/Archive/Conversations

# Каталог mutable RocksDB. Устойчивый default без изменения .env:
# <HOME>/Library/Application Support/ai-baka/rocksdb. Override допускается
# только на другом абсолютном внутреннем APFS/POSIX пути.
# ExFAT для live RocksDB не поддержан; raw/backups остаются в BAKA_ARCHIVE_ROOT.
# BAKA_DB_ROOT=/Users/your-user/Library/Application Support/ai-baka/rocksdb

# Отдельный экземпляр SurrealDB (не External System), только loopback 127.0.0.1:8901.
# Локальный single-user инстанс: root/root допустим (решение владельца).
SURREAL_USER=root
SURREAL_PASS=root
SURREAL_URL=ws://127.0.0.1:8901/rpc
SURREAL_NAMESPACE=baka
SURREAL_DATABASE=archive

# Максимальное тело HTTP /import в байтах. 34359738368 = 32 GiB: bounded
# запас для текущего restore и ожидаемого post-migration export. Увеличивать
# только после проверки SHA/size аутентифицированного backup и измерения его
# фактического распакованного/reordered import; unlimited-значения запрещены.
SURREAL_HTTP_MAX_IMPORT_BODY_SIZE=34359738368

# Если задан, preflight сверяет UUID sentinel-файла с этим значением.
# BAKA_ARCHIVE_ID=

# Нужен только для `baka embeddings run` и `baka search --mode vector|hybrid`;
# обычный sync работает без него. Не коммитить, не логировать.
# OPENAI_API_KEY=

# Политика приватности embeddings (docs/plan.md §13.7): перечисленные
# harness'ы/workspaces/типы документов НЕ отправляются в OpenAI
# (списки через запятую). В provider уходит только content документа.
# EMBEDDINGS_EXCLUDE_HARNESSES=codex,cursor
# EMBEDDINGS_EXCLUDE_WORKSPACES=
# EMBEDDINGS_EXCLUDE_DOCUMENT_TYPES=user_prompt,assistant_final
# Документы больше этого размера (UTF-8 bytes) не отправляются.
# EMBEDDINGS_MAX_DOCUMENT_BYTES=100000

# Тариф для оценки стоимости в `baka embeddings plan` (USD за 1M input
# tokens). Только для плана, в коде не захардкожен.
# OPENAI_EMBEDDING_PRICE_PER_1M_TOKENS=0.13

# Сколько последовательных complete-scan без файла подтверждают удаление.
# BAKA_DELETION_CONFIRMATIONS=2

# Минимум свободного места на диске архива (байты), по умолчанию 1 GiB.
# Capacity live DB/recovery при BAKA_DB_ROOT проверяется оператором отдельно.
# BAKA_MIN_FREE_BYTES=1073741824

# Переопределение source roots конкретного harness'а (`baka discover`).
# Формат: список путей через запятую; "~" разворачивается в home.
# Если переменная задана, дефолтные пути этого harness'а (docs/sources.md)
# полностью заменяются. KIMI_CODE_HOME также учитывается для kimi-code.
# BAKA_SOURCES__CODEX=~/.codex/sessions,~/.codex/archived_sessions
# BAKA_SOURCES__CLAUDE_CODE=
# BAKA_SOURCES__CLAUDE_DESKTOP=
# BAKA_SOURCES__OPENCODE=
# BAKA_SOURCES__CURSOR=
# BAKA_SOURCES__QWEN_CODE=
# BAKA_SOURCES__KIMI_CODE=
# BAKA_SOURCES__OMP=

# Путь к legacy index.sqlite для `baka migration plan` (docs/plan.md §15).
# Команда работает со snapshot-копией в <archive>/migration-input/, оригинал
# не изменяется.
# BAKA_LEGACY_DB=/Volumes/Archive/Legacy Conversations/index.sqlite
