# Корень архива на внешнем диске. Без sentinel-файла .baka-archive.json
# по этому пути любая операция записи блокируется.
BAKA_ARCHIVE_ROOT=/Volumes/Archive/Conversations

# Отдельный экземпляр SurrealDB (не External System), только loopback 127.0.0.1:8901.
# Локальный single-user инстанс: root/root допустим (решение владельца).
SURREAL_USER=root
SURREAL_PASS=root
SURREAL_URL=ws://127.0.0.1:8901/rpc
SURREAL_NAMESPACE=baka
SURREAL_DATABASE=archive

# Если задан, preflight сверяет UUID sentinel-файла с этим значением.
# BAKA_ARCHIVE_ID=

# Нужен только для `baka embeddings run`; обычный sync работает без него.
# OPENAI_API_KEY=

# Сколько последовательных complete-scan без файла подтверждают удаление.
# BAKA_DELETION_CONFIRMATIONS=2

# Минимум свободного места на диске архива (байты), по умолчанию 1 GiB.
# BAKA_MIN_FREE_BYTES=1073741824

# Переопределение source roots конкретного harness'а (`baka discover`).
# Формат: список путей через запятую; "~" разворачивается в home.
# Если переменная задана, дефолтные пути этого harness'а (docs/sources.md)
# полностью заменяются. KIMI_CODE_HOME также учитывается для kimi-code.
# BAKA_SOURCES__CODEX=~/.codex/sessions,~/.codex/archived_sessions
# BAKA_SOURCES__CLAUDE_CODE=
# BAKA_SOURCES__CLAUDE_DESKTOP=
# BAKA_SOURCES__OPENCODE=
# BAKA_SOURCES__CURSOR=
# BAKA_SOURCES__QWEN_CODE=
# BAKA_SOURCES__KIMI_CODE=
