{
  "name": "ai-baka",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "bin": {
    "baka": "./src/cli.ts"
  },
  "scripts": {
    "baka": "bun run src/cli.ts",
    "archive:init": "bun run src/cli.ts archive:init",
    "discover": "bun run src/cli.ts discover",
    "sync": "bun run src/cli.ts sync",
    "export:sqlite": "bun run src/cli.ts export:sqlite",
    "status": "bun run src/cli.ts status",
    "validate": "bun run src/cli.ts validate",
    "db:preflight": "bun run src/cli.ts db preflight",
    "db:up": "bun run src/cli.ts db up",
    "db:down": "bun run src/cli.ts db down",
    "db:status": "bun run src/cli.ts db status",
    "db:migrate": "bun run src/cli.ts db migrate",
    "db:logs": "bun run src/cli.ts db logs",
    "db:backup": "bun run src/cli.ts backup",
    "db:restore:test": "bun run src/cli.ts restore:test",
    "raw:verify": "bun run src/cli.ts raw:verify",
    "disk:eject": "bun run src/cli.ts disk eject",
    "report:model-efficiency": "bun run scripts/model-efficiency-report.ts",
    "test": "bun test --timeout 30000",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "15.0.0",
    "echarts": "6.1.0",
    "surrealdb": "2.0.8"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  }
}
